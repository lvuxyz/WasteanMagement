# Địa chỉ gốc của API backend, gồm cả tiền tố phiên bản.
# Bỏ trống (mặc định) để dùng máy chủ đang chọn bằng `_selectedBaseUrl` trong
# lib/core/api/api_constants.dart. Điền vào đây để ghi đè mà không phải sửa mã.
# Ví dụ khi chạy backend ngay trên máy dev: http://localhost:5001/api/v1
# Trên emulator Android, localhost/127.0.0.1 tự được đổi thành 10.0.2.2.
API_BASE_URL=

# Token công khai của Mapbox (pk.*) dùng để hiển thị bản đồ trong ứng dụng.
MAPBOX_ACCESS_TOKEN=

# Token tải SDK của Mapbox (sk.*), chỉ dùng lúc build Android.
# Đặt trong android/gradle.properties hoặc biến môi trường, KHÔNG commit.
MAPBOX_DOWNLOADS_TOKEN=

# API key của OpenAI cho trợ lý AI.
OPENAI_API_KEY=
